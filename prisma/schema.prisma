generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id           String  @id @default(uuid()) @db.Uuid
  category     String
  title        String
  image        String?
  stockBadge   String?
  price        String
  rating       Float?
  reviewCount  Int?
  ctaText      String
  ctaHref      String?
  description  String?
  highlight    String?
  badge        String?
  paletteColor String?
  icon         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  PLATFORM_ADMIN
  CUSTOMER
}

enum ProviderType {
  SELF_EMPLOYED
  COMPANY
}

enum ProviderMemberRole {
  OWNER
  MANAGER
}

enum ProviderMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  systemRole       SystemRole       @default(CUSTOMER)
  passwordHash     String?
  activeProviderId String?          @db.Uuid
  accounts         Account[]
  sessions         Session[]
  providerMemberships ProviderMember[]
  ownedProviders   Provider[]       @relation("ProviderOwner")
  createdServices  Service[]        @relation("ServiceCreatedBy")
  updatedServices  Service[]        @relation("ServiceUpdatedBy")
  activeProvider   Provider?        @relation("ActiveProvider", fields: [activeProviderId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([systemRole])
  @@index([activeProviderId])
}

model Account {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Provider {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  slug        String         @unique
  type        ProviderType
  ownerUserId String?        @db.Uuid
  ownerUser   User?          @relation("ProviderOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members     ProviderMember[]
  services    Service[]
  activeUsers User[]         @relation("ActiveProvider")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([ownerUserId])
  @@index([type])
}

model ProviderMember {
  id         String               @id @default(uuid()) @db.Uuid
  providerId String               @db.Uuid
  userId     String               @db.Uuid
  role       ProviderMemberRole
  status     ProviderMemberStatus @default(ACTIVE)
  provider   Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([providerId, userId])
  @@index([userId])
  @@index([providerId, role, status])
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  category        String
  title           String
  image           String?
  stockBadge      String?
  price           String
  rating          Float?
  reviewCount     Int?
  ctaText         String
  ctaHref         String?
  description     String?
  highlight       String?
  badge           String?
  paletteColor    String?
  icon            String?
  providerId      String    @db.Uuid
  createdByUserId String?   @db.Uuid
  updatedByUserId String?   @db.Uuid
  provider        Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdByUser   User?     @relation("ServiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?     @relation("ServiceUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([providerId])
}
